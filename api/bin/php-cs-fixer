#!/usr/bin/env php
<?php

declare(strict_types=1);

define('PROJECT_DIR', dirname(__DIR__));

$autoload = PROJECT_DIR.'/vendor/autoload.php';
$fixer = PROJECT_DIR.'/vendor/friendsofphp/php-cs-fixer/php-cs-fixer';

if (!is_file($autoload) || !is_file($fixer)) {
    fwrite(STDERR, 'PHP-CS-Fixer dependencies are unavailable. Run composer install.'.PHP_EOL);
    exit(1);
}

require $fixer;